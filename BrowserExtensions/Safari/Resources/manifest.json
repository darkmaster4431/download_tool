{
  "manifest_version": 2,
  "name": "FlashFlow Safari Catcher",
  "version": "0.2.0",
  "description": "Send recognizable Safari download links to FlashFlow.",
  "permissions": ["nativeMessaging", "storage", "http://*/*", "https://*/*"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
