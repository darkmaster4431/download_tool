{
  "manifest_version": 3,
  "name": "FlashFlow Download Catcher",
  "version": "0.2.0",
  "description": "Send Chrome downloads to the local FlashFlow app.",
  "key": "",
  "permissions": ["downloads", "nativeMessaging", "storage"],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "FlashFlow",
    "default_popup": "popup.html"
  }
}
